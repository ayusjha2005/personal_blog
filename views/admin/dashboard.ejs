<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <script>
    (function() {
      try {
        var saved = localStorage.getItem('theme');
        var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}
    })();
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/css/themes.css">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/admin.css?v=3">

  <style>
    /* Critical Admin Layout Shell - Immune to caching */
    html, body.admin-layout { height: 100%; min-height: 100vh; margin: 0; padding: 0; }
    body.admin-layout {
      display: flex !important;
      flex-direction: row !important;
      align-items: stretch !important;
      min-height: 100vh !important;
      background-color: var(--bg-primary);
      overflow-x: hidden;
      width: 100%;
    }
    .admin-sidebar {
      width: 260px !important;
      min-width: 260px !important;
      max-width: 260px !important;
      height: 100vh !important;
      position: sticky !important;
      top: 0 !important;
      left: 0 !important;
      flex-shrink: 0 !important;
      overflow-y: auto;
      z-index: 50;
    }
    .admin-main {
      flex: 1 1 0% !important;
      min-width: 0 !important;
      width: calc(100% - 260px) !important;
      min-height: 100vh !important;
      display: flex !important;
      flex-direction: column !important;
    }
    .admin-topbar {
      height: 4.25rem !important;
      min-height: 4.25rem !important;
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      padding: 0 2rem !important;
      position: sticky;
      top: 0;
      z-index: 40;
    }
    .admin-content {
      padding: 2rem !important;
      flex: 1 0 auto !important;
      min-width: 0 !important;
    }
  </style>
</head>
<body class="admin-layout">
  <%- include('sidebar') %>

  <div class="admin-main">
    <header class="admin-topbar">
      <h1 style="font-size: 1.25rem; font-weight: 700;">Dashboard Overview</h1>
      <div style="display: flex; align-items: center; gap: 1rem;">
        <a href="/admin/articles/new" class="btn-pill-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          <span>New Article</span>
        </a>
      </div>
    </header>

    <main class="admin-content">
      <!-- Stats Cards -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-title">Published Articles</div>
          <div class="stat-val" style="color: #059669;"><%= stats.totalPublished %></div>
        </div>

        <div class="stat-card">
          <div class="stat-title">Drafts</div>
          <div class="stat-val" style="color: #D97706;"><%= stats.totalDrafts %></div>
        </div>

        <div class="stat-card">
          <div class="stat-title">Total Articles</div>
          <div class="stat-val"><%= stats.totalArticles %></div>
        </div>

        <div class="stat-card">
          <div class="stat-title">Contact Messages</div>
          <div class="stat-val" style="color: #7C3AED;">
            <%= unreadCount > 0 ? unreadCount + ' unread' : 'All read' %>
          </div>
        </div>
      </div>

      <!-- Recent Articles Section -->
      <div class="data-card">
        <div class="data-card-header">
          <h2 style="font-size: 1.1rem; font-weight: 700;">Recent Articles</h2>
          <a href="/admin/articles" style="font-size: 0.85rem; font-weight: 600; color: var(--text-secondary);">
            View all &rarr;
          </a>
        </div>

        <div style="overflow-x: auto;">
          <table class="data-table">
            <thead>
              <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Status</th>
                <th>Date</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (recentArticles && recentArticles.length > 0) { %>
                <% recentArticles.forEach(function(article) { %>
                  <tr>
                    <td style="font-weight: 600; max-width: 320px;">
                      <%= article.title %>
                      <% if (article.isFeatured) { %>
                        <span style="font-size: 0.7rem; background: #EFF6FF; color: #2563EB; padding: 0.15rem 0.4rem; border-radius: 4px; margin-left: 0.35rem;">Featured</span>
                      <% } %>
                    </td>
                    <td><%= article.category ? article.category.name : 'Uncategorized' %></td>
                    <td>
                      <span class="table-status-pill <%= article.status === 'published' ? 'status-published' : 'status-draft' %>">
                        <%= article.status %>
                      </span>
                    </td>
                    <td><%= formatDate(article.publishedAt || article.createdAt) %></td>
                    <td>
                      <div class="table-actions">
                        <a href="/admin/articles/edit/<%= article._id %>" class="icon-btn" title="Edit Article">
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                          </svg>
                        </a>
                        <a href="/blog/<%= article.slug %>" target="_blank" class="icon-btn" title="View Public">
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                          </svg>
                        </a>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="5" style="text-align: center; padding: 2rem; color: var(--text-muted);">
                    No articles created yet.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Recent Messages Section -->
      <div class="data-card">
        <div class="data-card-header">
          <h2 style="font-size: 1.1rem; font-weight: 700;">Recent Messages</h2>
          <a href="/admin/messages" style="font-size: 0.85rem; font-weight: 600; color: var(--text-secondary);">
            View all &rarr;
          </a>
        </div>

        <div style="overflow-x: auto;">
          <table class="data-table">
            <thead>
              <tr>
                <th>Sender</th>
                <th>Subject</th>
                <th>Date</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% if (recentMessages && recentMessages.length > 0) { %>
                <% recentMessages.forEach(function(msg) { %>
                  <tr>
                    <td>
                      <div style="font-weight: 600;"><%= msg.name %></div>
                      <div style="font-size: 0.75rem; color: var(--text-muted);"><%= msg.email %></div>
                    </td>
                    <td><%= msg.subject %></td>
                    <td><%= formatDate(msg.createdAt) %></td>
                    <td>
                      <span class="table-status-pill <%= msg.status === 'read' ? 'status-published' : 'status-draft' %>">
                        <%= msg.status %>
                      </span>
                    </td>
                    <td>
                      <a href="/admin/messages" class="btn-pill-outline" style="padding: 0.3rem 0.75rem; font-size: 0.75rem;">
                        View
                      </a>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="5" style="text-align: center; padding: 2rem; color: var(--text-muted);">
                    No messages received yet.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <script src="/js/theme.js"></script>
</body>
</html>
