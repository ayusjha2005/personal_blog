<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <script>
    (function() {
      try {
        var saved = localStorage.getItem('theme');
        var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}
    })();
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/css/themes.css">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/admin.css?v=3">

  <style>
    /* Base layout defaults handled cleanly by admin.css */
    html, body.admin-layout { height: 100%; min-height: 100vh; margin: 0; padding: 0; }

    /* Immediate inlined styles for robust avatar upload UI */
    .image-upload-wrapper { width: 100%; position: relative; }
    .avatar-upload-area {
      max-width: 500px;
      display: block;
      border: 2px dashed rgba(255, 255, 255, 0.18);
      border-radius: 14px;
      padding: 2.25rem 1.5rem;
      text-align: center;
      cursor: pointer;
      background: rgba(255, 255, 255, 0.02);
      transition: all 0.2s ease;
      box-sizing: border-box;
    }
    [data-theme="light"] .avatar-upload-area {
      border: 2px dashed #D1D5DB;
      background: #F9FAFB;
    }
    .avatar-upload-area:hover, .avatar-upload-area.dragover {
      border-color: #3B82F6 !important;
      background: rgba(59, 130, 246, 0.06) !important;
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
    }
    .upload-placeholder {
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: center !important;
      gap: 0.75rem !important;
    }
    .upload-icon-circle {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: rgba(59, 130, 246, 0.14);
      color: #3B82F6;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 0.25rem;
    }
    .upload-text-block {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      align-items: center;
    }
    .upload-placeholder-title {
      font-size: 0.95rem;
      font-weight: 600;
      color: inherit;
    }
    .upload-browse-link {
      color: #3B82F6;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .upload-placeholder-hint {
      font-size: 0.8rem;
      color: var(--text-muted, #9CA3AF);
    }
    .upload-btn {
      display: inline-flex !important;
      align-items: center !important;
      gap: 0.5rem !important;
      padding: 0.55rem 1.25rem !important;
      background: #2563EB !important;
      color: #FFFFFF !important;
      border: none !important;
      border-radius: 9999px !important;
      font-size: 0.85rem !important;
      font-weight: 600 !important;
      cursor: pointer !important;
      box-shadow: 0 2px 8px rgba(37, 99, 235, 0.35) !important;
      margin-top: 0.35rem !important;
      transition: all 0.2s ease !important;
    }
    .upload-btn:hover {
      background: #1D4ED8 !important;
      transform: translateY(-1px);
    }
    .avatar-preview-card {
      max-width: 500px;
      border-radius: 14px;
      overflow: hidden;
      background: var(--bg-surface, #1A1D24);
      border: 1px solid var(--border-light, rgba(255, 255, 255, 0.12));
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }
    .avatar-preview-media {
      padding: 2rem 1rem;
      display: flex;
      justify-content: center;
      align-items: center;
      background: var(--bg-surface-elevated, #16181D);
      position: relative;
    }
    .image-preview-img.avatar {
      width: 140px !important;
      height: 140px !important;
      border-radius: 50% !important;
      object-fit: cover !important;
      border: 3px solid #3B82F6 !important;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35) !important;
      display: block;
    }
    .image-preview-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.85rem 1.15rem;
      background: var(--bg-surface-elevated, #16181D);
      border-top: 1px solid var(--border-light, rgba(255, 255, 255, 0.08));
    }
    .image-meta {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      color: var(--text-secondary, #9CA3AF);
      font-size: 0.85rem;
      overflow: hidden;
      max-width: 60%;
    }
    .image-preview-name {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      font-weight: 500;
      color: var(--text-primary, #FFFFFF);
    }
    .image-preview-actions {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }
    .image-action-btn {
      display: inline-flex !important;
      align-items: center !important;
      gap: 0.4rem !important;
      padding: 0.45rem 0.9rem !important;
      font-size: 0.8rem !important;
      font-weight: 600 !important;
      border-radius: 8px !important;
      cursor: pointer !important;
      transition: all 0.15s ease !important;
    }
    .image-action-btn.change {
      background: var(--bg-surface, #21262D) !important;
      color: var(--text-primary, #F0F6FC) !important;
      border: 1px solid var(--border-light, rgba(255, 255, 255, 0.15)) !important;
    }
    .image-action-btn.change:hover {
      background: var(--bg-hover, #30363D) !important;
      border-color: #3B82F6 !important;
    }
    .image-action-btn.remove {
      background: rgba(220, 38, 38, 0.12) !important;
      color: #F87171 !important;
      border: 1px solid rgba(220, 38, 38, 0.3) !important;
    }
    .image-action-btn.remove:hover {
      background: #DC2626 !important;
      color: #FFFFFF !important;
      border-color: #DC2626 !important;
    }
    .upload-error-box {
      margin-top: 0.6rem;
      padding: 0.65rem 0.9rem;
      background: rgba(220, 38, 38, 0.1);
      border: 1px solid rgba(220, 38, 38, 0.3);
      border-radius: 8px;
      color: #F87171;
      font-size: 0.85rem;
      font-weight: 500;
    }
  </style>
</head>
<body class="admin-layout">
  <%- include('sidebar') %>

  <div class="admin-main">
    <header class="admin-topbar">
      <div class="admin-topbar-left">
        <button type="button" class="admin-menu-btn" aria-label="Open navigation menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
        <h1 style="font-size: 1.25rem; font-weight: 700; margin: 0;">Site &amp; Profile Settings</h1>
      </div>
      <button type="submit" form="profile-form" class="btn-pill-primary">
        Save Settings
      </button>
    </header>

    <main class="admin-content">
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success" role="alert"><%= success %></div>
      <% } %>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error" role="alert"><%= error %></div>
      <% } %>

      <form id="profile-form" action="/admin/profile" method="POST" enctype="multipart/form-data">
        <!-- Identity & Hero -->
        <div class="data-card" style="padding: 2rem;">
          <h2 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 1.5rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-light);">
            Identity &amp; Hero Section
          </h2>

          <div class="form-grid-2">
            <div class="form-group">
              <label for="name" class="form-label">Display Name</label>
              <input type="text" id="name" name="name" class="form-input" value="<%= profile.name || 'Ayush Jha' %>" required>
            </div>

            <div class="form-group">
              <label for="heroHeadline" class="form-label">Hero Headline</label>
              <input type="text" id="heroHeadline" name="heroHeadline" class="form-input" value="<%= profile.heroHeadline || 'Ideas. Code. Progress.' %>" required>
            </div>

            <div class="form-group form-full">
              <label for="tagline" class="form-label">Personal Tagline</label>
              <input type="text" id="tagline" name="tagline" class="form-input" value="<%= profile.tagline || 'Learning in public, building in private.' %>" required>
            </div>

            <div class="form-group form-full">
              <label for="bio" class="form-label">Short Biography (Hero &amp; About intro)</label>
              <textarea id="bio" name="bio" class="form-textarea" style="min-height: 80px;" required><%= profile.bio || '' %></textarea>
            </div>

            <div class="form-group form-full">
              <label for="extendedBio" class="form-label">Extended Biography (About page)</label>
              <textarea id="extendedBio" name="extendedBio" class="form-textarea" style="min-height: 80px;" required><%= profile.extendedBio || '' %></textarea>
            </div>
          </div>
        </div>

        <!-- Handwritten Quotes & Visuals -->
        <div class="data-card" style="padding: 2rem;">
          <h2 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 1.5rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-light);">
            Handwritten Cursive Quotes &amp; Images
          </h2>

          <div class="form-grid-2">
            <div class="form-group">
              <label for="heroScriptQuote" class="form-label">Hero Cursive Phrase</label>
              <input type="text" id="heroScriptQuote" name="heroScriptQuote" class="form-input" value="<%= profile.heroScriptQuote || 'Better Code, Brighter Days' %>">
            </div>

            <div class="form-group">
              <label for="aboutScriptQuote" class="form-label">About Page Cursive Phrase</label>
              <input type="text" id="aboutScriptQuote" name="aboutScriptQuote" class="form-input" value="<%= profile.aboutScriptQuote || 'Just a guy who loves building things.' %>">
            </div>

            <div class="form-group">
              <label for="contactScriptQuote" class="form-label">Contact Card Cursive Phrase</label>
              <input type="text" id="contactScriptQuote" name="contactScriptQuote" class="form-input" value="<%= profile.contactScriptQuote || "Let's Build Something Amazing." %>">
            </div>

            <!-- Profile Photo Upload -->
            <div class="form-group form-full">
              <label class="form-label" style="font-weight: 600; margin-bottom: 0.6rem; display: block;">Profile Photo</label>
              <% const currentProfile = profile.profileImage || '/images/profile.jpg'; %>
              <input type="hidden" name="existingProfileImage" value="<%= currentProfile %>">

              <div class="image-upload-wrapper" id="profileUploadWrapper">
                <!-- Dropzone Area -->
                <div class="image-upload-area avatar-upload-area <%= currentProfile ? 'has-image' : '' %>" id="profileDropZone" style="<%= currentProfile ? 'display: none;' : 'display: block;' %>">
                  <div class="upload-placeholder" id="profilePlaceholder">
                    <div class="upload-icon-circle">
                      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                      </svg>
                    </div>
                    <div class="upload-text-block">
                      <span class="upload-placeholder-title">Drop your photo here, or <span class="upload-browse-link">browse</span></span>
                      <span class="upload-placeholder-hint">Square portrait recommended &bull; Maximum file size: 5 MB</span>
                    </div>
                    <button type="button" class="upload-btn" id="profileBrowseBtn">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="17 8 12 3 7 8"></polyline>
                        <line x1="12" y1="3" x2="12" y2="15"></line>
                      </svg>
                      Choose Photo
                    </button>
                  </div>
                </div>

                <!-- Preview Card -->
                <div class="avatar-preview-card" id="profilePreview" style="<%= currentProfile ? 'display: block;' : 'display: none;' %>">
                  <div class="avatar-preview-media">
                    <div class="preview-badge" id="profileBadge">Profile Photo</div>
                    <img 
                      class="image-preview-img avatar" 
                      id="profilePreviewImg" 
                      <% if (currentProfile) { %>src="<%= currentProfile %>"<% } %>
                      alt="Profile preview"
                      style="<%= currentProfile ? 'display: block;' : 'display: none;' %>"
                    >
                  </div>
                  <div class="image-preview-footer">
                    <div class="image-meta">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                      </svg>
                      <span class="image-preview-name" id="profileFileName"><%= currentProfile ? currentProfile.split('/').pop() : '' %></span>
                    </div>
                    <div class="image-preview-actions">
                      <button type="button" class="image-action-btn change" id="profileChangeBtn">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                          <polyline points="17 8 12 3 7 8"></polyline>
                          <line x1="12" y1="3" x2="12" y2="15"></line>
                        </svg>
                        Change
                      </button>
                      <button type="button" class="image-action-btn remove" id="profileRemoveBtn">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <polyline points="3 6 5 6 21 6"></polyline>
                          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        </svg>
                        Remove
                      </button>
                    </div>
                  </div>
                </div>

                <div class="upload-error-box" id="profileUploadError" style="display: none;"></div>
                <input 
                  type="file" 
                  id="profileImageInput" 
                  name="profileImage" 
                  accept="image/jpeg, image/png, image/webp" 
                  style="display: none;"
                >
              </div>
            </div>
          </div>
        </div>

        <!-- Badges & Contact Info -->
        <div class="data-card" style="padding: 2rem;">
          <h2 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 1.5rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-light);">
            About Badges &amp; Contact Info
          </h2>

          <div class="form-grid-2">
            <div class="form-group">
              <label for="degree" class="form-label">Education / Degree</label>
              <input type="text" id="degree" name="degree" class="form-input" value="<%= profile.degree || 'B.Tech CSE (CSBS) @ VIT-AP' %>">
            </div>

            <div class="form-group">
              <label for="location" class="form-label">Location</label>
              <input type="text" id="location" name="location" class="form-input" value="<%= profile.location || 'Based in India' %>">
            </div>

            <div class="form-group">
              <label for="statusText" class="form-label">Status Phrase</label>
              <input type="text" id="statusText" name="statusText" class="form-input" value="<%= profile.statusText || 'Always learning' %>">
            </div>

            <div class="form-group">
              <label for="contactEmail" class="form-label">Contact Email Address</label>
              <input type="email" id="contactEmail" name="contactEmail" class="form-input" value="<%= profile.contactEmail || 'ayushjha@gmail.com' %>">
            </div>
          </div>
        </div>

        <!-- Social Links -->
        <div class="data-card" style="padding: 2rem;">
          <h2 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 1.5rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-light);">
            Social Media Profiles
          </h2>

          <div class="form-grid-2">
            <div class="form-group">
              <label for="github" class="form-label">GitHub URL</label>
              <input type="url" id="github" name="github" class="form-input" value="<%= (profile.socialLinks && profile.socialLinks.github) || 'https://github.com/ayushjha' %>">
            </div>

            <div class="form-group">
              <label for="linkedin" class="form-label">LinkedIn URL</label>
              <input type="url" id="linkedin" name="linkedin" class="form-input" value="<%= (profile.socialLinks && profile.socialLinks.linkedin) || 'https://linkedin.com/in/ayushjha' %>">
            </div>

            <div class="form-group">
              <label for="twitter" class="form-label">X / Twitter URL</label>
              <input type="url" id="twitter" name="twitter" class="form-input" value="<%= (profile.socialLinks && profile.socialLinks.twitter) || 'https://x.com/ayushjha' %>">
            </div>

            <div class="form-group">
              <label for="instagram" class="form-label">Instagram URL</label>
              <input type="url" id="instagram" name="instagram" class="form-input" value="<%= (profile.socialLinks && profile.socialLinks.instagram) || 'https://instagram.com/ayushjha' %>">
            </div>

            <div class="form-group">
              <label for="youtube" class="form-label">YouTube URL (optional)</label>
              <input type="url" id="youtube" name="youtube" class="form-input" value="<%= (profile.socialLinks && profile.socialLinks.youtube) || '' %>">
            </div>

            <div class="form-group">
              <label for="email" class="form-label">Email URL / Address</label>
              <input type="text" id="email" name="email" class="form-input" value="<%= (profile.socialLinks && profile.socialLinks.email) || 'ayushjha@gmail.com' %>">
            </div>
          </div>
        </div>

        <!-- SEO & Footer -->
        <div class="data-card" style="padding: 2rem;">
          <h2 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 1.5rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-light);">
            SEO Defaults &amp; Footer
          </h2>

          <div class="form-grid-2">
            <div class="form-group">
              <label for="seoTitle" class="form-label">Default SEO Title</label>
              <input type="text" id="seoTitle" name="seoTitle" class="form-input" value="<%= profile.seoTitle || 'Ayush Jha | Ideas. Code. Progress.' %>">
            </div>

            <div class="form-group">
              <label for="footerText" class="form-label">Footer Copyright Text</label>
              <input type="text" id="footerText" name="footerText" class="form-input" value="<%= profile.footerText || '© 2026 Ayush Jha. All rights reserved.' %>">
            </div>

            <div class="form-group form-full">
              <label for="seoDescription" class="form-label">Default SEO Meta Description</label>
              <textarea id="seoDescription" name="seoDescription" class="form-textarea" style="min-height: 70px;"><%= profile.seoDescription || '' %></textarea>
            </div>
          </div>
        </div>
      </form>
    </main>
  </div>

  <script src="/js/theme.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // ── Profile Photo Upload UI ──
      const profileInput = document.getElementById('profileImageInput');
      const dropZone = document.getElementById('profileDropZone');
      const placeholder = document.getElementById('profilePlaceholder');
      const preview = document.getElementById('profilePreview');
      const previewImg = document.getElementById('profilePreviewImg');
      const fileName = document.getElementById('profileFileName');
      const browseBtn = document.getElementById('profileBrowseBtn');
      const changeBtn = document.getElementById('profileChangeBtn');
      const removeBtn = document.getElementById('profileRemoveBtn');
      const errorEl = document.getElementById('profileUploadError');
      const existingInput = document.querySelector('input[name="existingProfileImage"]');

      const MAX_SIZE = 5 * 1024 * 1024;
      const ALLOWED = ['image/jpeg', 'image/png', 'image/webp'];

      function formatSize(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / 1048576).toFixed(1) + ' MB';
      }

      function showError(msg) {
        errorEl.textContent = msg;
        errorEl.style.display = 'block';
      }

      function clearError() {
        errorEl.textContent = '';
        errorEl.style.display = 'none';
      }

      function handleFile(file) {
        clearError();

        if (!ALLOWED.includes(file.type)) {
          showError('Unsupported file type. Please use JPEG, PNG, or WebP.');
          return;
        }

        if (file.size > MAX_SIZE) {
          showError(`File is too large (${formatSize(file.size)}). Maximum size is 5 MB.`);
          return;
        }

        // Show preview
        const url = URL.createObjectURL(file);
        previewImg.src = url;
        previewImg.style.display = 'block';
        fileName.textContent = `${file.name} (${formatSize(file.size)})`;
        dropZone.style.display = 'none';
        preview.style.display = 'block';
      }

      function openFilePicker() {
        profileInput.click();
      }

      profileInput.addEventListener('change', () => {
        if (profileInput.files && profileInput.files[0]) {
          handleFile(profileInput.files[0]);
        }
      });

      browseBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        openFilePicker();
      });

      dropZone.addEventListener('click', (e) => {
        openFilePicker();
      });

      changeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        openFilePicker();
      });

      removeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        profileInput.value = '';
        previewImg.removeAttribute('src');
        previewImg.style.display = 'none';
        fileName.textContent = '';
        preview.style.display = 'none';
        dropZone.style.display = 'block';
        dropZone.classList.remove('has-image');
        existingInput.value = '';
        clearError();
      });

      // Drag and drop
      dropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.classList.add('dragover');
      });

      dropZone.addEventListener('dragleave', () => {
        dropZone.classList.remove('dragover');
      });

      dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('dragover');
        if (e.dataTransfer.files && e.dataTransfer.files[0]) {
          const dt = new DataTransfer();
          dt.items.add(e.dataTransfer.files[0]);
          profileInput.files = dt.files;
          handleFile(e.dataTransfer.files[0]);
        }
      });
    });
  </script>
</body>
</html>
