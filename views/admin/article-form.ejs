<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <script>
    (function() {
      try {
        var saved = localStorage.getItem('theme');
        var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}
    })();
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/css/themes.css">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/admin.css">

  <!-- Marked library for live client-side preview in admin editor -->
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
</head>
<body class="admin-layout">
  <%- include('sidebar') %>

  <div class="admin-main">
    <header class="admin-topbar">
      <h1 style="font-size: 1.25rem; font-weight: 700;">
        <%= isEdit ? 'Edit Article' : 'Create New Article' %>
      </h1>
      <div style="display: flex; gap: 0.75rem;">
        <a href="/admin/articles" class="btn-pill-outline">Cancel</a>
        <button type="submit" form="article-form" class="btn-pill-primary">
          <%= isEdit ? 'Save Changes' : 'Create Article' %>
        </button>
      </div>
    </header>

    <main class="admin-content">
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error" role="alert"><%= error %></div>
      <% } %>

      <form 
        id="article-form" 
        action="<%= isEdit ? '/admin/articles/edit/' + article._id : '/admin/articles/new' %>" 
        method="POST"
        enctype="multipart/form-data"
      >
        <div class="data-card" style="padding: 2rem;">
          <div class="form-grid-2">
            <!-- Title -->
            <div class="form-group form-full">
              <label for="title" class="form-label">Article Title *</label>
              <input 
                type="text" 
                id="title" 
                name="title" 
                class="form-input" 
                required 
                maxlength="200"
                placeholder="e.g. How I Set Up My Developer Environment"
                value="<%= article.title || '' %>"
              >
            </div>

            <!-- Slug -->
            <div class="form-group">
              <label for="slug" class="form-label">Slug (URL identifier) *</label>
              <input 
                type="text" 
                id="slug" 
                name="slug" 
                class="form-input" 
                required 
                placeholder="e.g. how-i-set-up-my-developer-environment"
                value="<%= article.slug || '' %>"
              >
            </div>

            <!-- Subtitle -->
            <div class="form-group">
              <label for="subtitle" class="form-label">Subtitle</label>
              <input 
                type="text" 
                id="subtitle" 
                name="subtitle" 
                class="form-input" 
                placeholder="A short subtitle under the title"
                value="<%= article.subtitle || '' %>"
              >
            </div>

            <!-- Category -->
            <div class="form-group">
              <label for="category" class="form-label">Category *</label>
              <select id="category" name="category" class="category-dropdown-select" style="width: 100%;" required>
                <% categories.forEach(function(cat) { %>
                  <option 
                    value="<%= cat._id %>" 
                    <%= (article.category && (article.category._id ? article.category._id.toString() : article.category.toString()) === cat._id.toString()) ? 'selected' : '' %>
                  >
                    <%= cat.name %>
                  </option>
                <% }); %>
              </select>
            </div>

            <!-- Status -->
            <div class="form-group">
              <label for="status" class="form-label">Publication Status *</label>
              <select id="status" name="status" class="category-dropdown-select" style="width: 100%;" required>
                <option value="draft" <%= article.status === 'draft' ? 'selected' : '' %>>Draft (Private)</option>
                <option value="published" <%= article.status === 'published' ? 'selected' : '' %>>Published (Public)</option>
              </select>
            </div>

            <!-- Cover Image Upload -->
            <div class="form-group form-full">
              <label class="form-label">Cover Image</label>
              <% const currentCover = article.coverImage || ''; %>
              <input type="hidden" name="existingCoverImage" value="<%= currentCover %>">

              <div class="image-upload-wrapper" id="coverUploadWrapper">
                <div class="image-upload-area <%= currentCover ? 'has-image' : '' %>" id="coverDropZone">
                  <!-- Placeholder (visible when no image) -->
                  <div class="upload-placeholder" id="coverPlaceholder" style="<%= currentCover ? 'display:none' : '' %>">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                      <circle cx="8.5" cy="8.5" r="1.5"></circle>
                      <polyline points="21 15 16 10 5 21"></polyline>
                    </svg>
                    <span class="upload-placeholder-text">Drop an image here or click to browse</span>
                    <span class="upload-placeholder-hint">JPEG, PNG, WebP — Max 5 MB</span>
                    <button type="button" class="upload-btn" id="coverBrowseBtn">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="17 8 12 3 7 8"></polyline>
                        <line x1="12" y1="3" x2="12" y2="15"></line>
                      </svg>
                      Choose Image
                    </button>
                  </div>

                  <!-- Preview (visible when image exists) -->
                  <div class="image-preview-container <%= currentCover ? 'visible' : '' %>" id="coverPreview">
                    <% if (isEdit && currentCover) { %>
                      <div class="current-image-label">Current Cover Image</div>
                    <% } %>
                    <img 
                      class="image-preview-img" 
                      id="coverPreviewImg" 
                      src="<%= currentCover || '' %>" 
                      alt="Cover image preview"
                    >
                    <div class="image-preview-info">
                      <span class="image-preview-name" id="coverFileName"><%= currentCover ? currentCover.split('/').pop() : '' %></span>
                      <div class="image-preview-actions">
                        <button type="button" class="image-action-btn" id="coverChangeBtn">Change</button>
                        <button type="button" class="image-action-btn remove" id="coverRemoveBtn">Remove</button>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="upload-error" id="coverUploadError"></div>
                <input 
                  type="file" 
                  id="coverImageInput" 
                  name="coverImage" 
                  accept="image/jpeg, image/png, image/webp" 
                  style="display: none;"
                >
              </div>
            </div>

            <!-- Tags -->
            <div class="form-group">
              <label for="tags" class="form-label">Tags (comma-separated)</label>
              <input 
                type="text" 
                id="tags" 
                name="tags" 
                class="form-input" 
                placeholder="Development, Linux, Productivity"
                value="<%= article.tags ? (Array.isArray(article.tags) ? article.tags.join(', ') : article.tags) : '' %>"
              >
            </div>

            <!-- Featured Checkbox -->
            <div class="form-group form-full" style="display: flex; align-items: center; gap: 0.5rem;">
              <input 
                type="checkbox" 
                id="isFeatured" 
                name="isFeatured" 
                <%= article.isFeatured ? 'checked' : '' %>
                style="width: 18px; height: 18px; cursor: pointer;"
              >
              <label for="isFeatured" style="font-size: 0.95rem; font-weight: 600; cursor: pointer;">
                Mark as Featured Article (shown prominently on Home page)
              </label>
            </div>

            <!-- Excerpt -->
            <div class="form-group form-full">
              <label for="excerpt" class="form-label">Excerpt / Summary *</label>
              <textarea 
                id="excerpt" 
                name="excerpt" 
                class="form-textarea" 
                style="min-height: 80px;" 
                required 
                maxlength="500"
                placeholder="Short summary for card previews..."
              ><%= article.excerpt || '' %></textarea>
            </div>

            <!-- Markdown Content Editor with Live Preview -->
            <div class="form-group form-full">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                <label for="content" class="form-label" style="margin-bottom: 0;">Article Content (Markdown supported) *</label>
                <span style="font-size: 0.75rem; color: var(--text-muted);">Live Preview on the Right &rarr;</span>
              </div>

              <div class="markdown-editor-split">
                <textarea 
                  id="content" 
                  name="content" 
                  class="markdown-textarea" 
                  required
                  placeholder="Write your article in Markdown..."
                ><%= article.content || '' %></textarea>

                <div id="markdown-preview" class="markdown-preview-pane prose">
                  <!-- Live markdown rendered here -->
                </div>
              </div>
            </div>
          </div>
        </div>
      </form>
    </main>
  </div>

  <script src="/js/theme.js"></script>
  <script>
    // Live Markdown Preview, Slug auto-generation, and Cover Image Upload
    document.addEventListener('DOMContentLoaded', () => {
      const titleInput = document.getElementById('title');
      const slugInput = document.getElementById('slug');
      const contentTextarea = document.getElementById('content');
      const previewPane = document.getElementById('markdown-preview');

      // Auto-generate slug from title if slug not customized
      <% if (!isEdit) { %>
        titleInput.addEventListener('input', () => {
          slugInput.value = titleInput.value
            .toLowerCase()
            .trim()
            .replace(/[^\w\s-]/g, '')
            .replace(/[\s_-]+/g, '-')
            .replace(/^-+|-+$/g, '');
        });
      <% } %>

      // Live markdown rendering
      function updatePreview() {
        if (typeof marked !== 'undefined') {
          previewPane.innerHTML = marked.parse(contentTextarea.value || '*Live preview will appear here as you type...*');
        }
      }

      contentTextarea.addEventListener('input', updatePreview);
      updatePreview();

      // ── Cover Image Upload UI ──
      const coverInput = document.getElementById('coverImageInput');
      const dropZone = document.getElementById('coverDropZone');
      const placeholder = document.getElementById('coverPlaceholder');
      const preview = document.getElementById('coverPreview');
      const previewImg = document.getElementById('coverPreviewImg');
      const fileName = document.getElementById('coverFileName');
      const browseBtn = document.getElementById('coverBrowseBtn');
      const changeBtn = document.getElementById('coverChangeBtn');
      const removeBtn = document.getElementById('coverRemoveBtn');
      const errorEl = document.getElementById('coverUploadError');
      const existingInput = document.querySelector('input[name="existingCoverImage"]');

      const MAX_SIZE = 5 * 1024 * 1024;
      const ALLOWED = ['image/jpeg', 'image/png', 'image/webp'];

      function formatSize(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / 1048576).toFixed(1) + ' MB';
      }

      function showError(msg) {
        errorEl.textContent = msg;
        errorEl.classList.add('visible');
      }

      function clearError() {
        errorEl.textContent = '';
        errorEl.classList.remove('visible');
      }

      function handleFile(file) {
        clearError();

        if (!ALLOWED.includes(file.type)) {
          showError('Unsupported file type. Please use JPEG, PNG, or WebP.');
          return;
        }

        if (file.size > MAX_SIZE) {
          showError(`File is too large (${formatSize(file.size)}). Maximum size is 5 MB.`);
          return;
        }

        // Show preview
        const url = URL.createObjectURL(file);
        previewImg.src = url;
        fileName.textContent = `${file.name} (${formatSize(file.size)})`;
        placeholder.style.display = 'none';
        preview.classList.add('visible');
        dropZone.classList.add('has-image');
      }

      function openFilePicker() {
        coverInput.click();
      }

      coverInput.addEventListener('change', () => {
        if (coverInput.files && coverInput.files[0]) {
          handleFile(coverInput.files[0]);
        }
      });

      browseBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        openFilePicker();
      });

      dropZone.addEventListener('click', (e) => {
        if (e.target === dropZone || e.target.closest('.upload-placeholder')) {
          openFilePicker();
        }
      });

      changeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        openFilePicker();
      });

      removeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        coverInput.value = '';
        previewImg.src = '';
        fileName.textContent = '';
        preview.classList.remove('visible');
        placeholder.style.display = '';
        dropZone.classList.remove('has-image');
        existingInput.value = '';
        clearError();
      });

      // Drag and drop
      dropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.classList.add('dragover');
      });

      dropZone.addEventListener('dragleave', () => {
        dropZone.classList.remove('dragover');
      });

      dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('dragover');
        if (e.dataTransfer.files && e.dataTransfer.files[0]) {
          // Set the file on the input
          const dt = new DataTransfer();
          dt.items.add(e.dataTransfer.files[0]);
          coverInput.files = dt.files;
          handleFile(e.dataTransfer.files[0]);
        }
      });
    });
  </script>
</body>
</html>

