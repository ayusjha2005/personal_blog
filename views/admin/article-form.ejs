<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <script>
    (function() {
      try {
        var saved = localStorage.getItem('theme');
        var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}
    })();
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/css/themes.css">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/admin.css?v=3">

  <style>
    /* Base layout defaults handled cleanly by admin.css */
    html, body.admin-layout { height: 100%; min-height: 100vh; margin: 0; padding: 0; }

    /* Immediate inlined styles for robust image upload UI */
    .image-upload-wrapper { width: 100%; position: relative; }
    .image-upload-area {
      display: block;
      width: 100%;
      border: 2px dashed rgba(255, 255, 255, 0.18);
      border-radius: 14px;
      padding: 2.25rem 1.5rem;
      text-align: center;
      cursor: pointer;
      background: rgba(255, 255, 255, 0.02);
      transition: all 0.2s ease;
      box-sizing: border-box;
    }
    [data-theme="light"] .image-upload-area {
      border: 2px dashed #D1D5DB;
      background: #F9FAFB;
    }
    .image-upload-area:hover, .image-upload-area.dragover {
      border-color: #3B82F6 !important;
      background: rgba(59, 130, 246, 0.06) !important;
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
    }
    .upload-placeholder {
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: center !important;
      gap: 0.75rem !important;
    }
    .upload-icon-circle {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: rgba(59, 130, 246, 0.14);
      color: #3B82F6;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 0.25rem;
    }
    .upload-text-block {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      align-items: center;
    }
    .upload-placeholder-title {
      font-size: 0.95rem;
      font-weight: 600;
      color: inherit;
    }
    .upload-browse-link {
      color: #3B82F6;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .upload-placeholder-hint {
      font-size: 0.8rem;
      color: var(--text-muted, #9CA3AF);
    }
    .upload-btn {
      display: inline-flex !important;
      align-items: center !important;
      gap: 0.5rem !important;
      padding: 0.55rem 1.25rem !important;
      background: #2563EB !important;
      color: #FFFFFF !important;
      border: none !important;
      border-radius: 9999px !important;
      font-size: 0.85rem !important;
      font-weight: 600 !important;
      cursor: pointer !important;
      box-shadow: 0 2px 8px rgba(37, 99, 235, 0.35) !important;
      margin-top: 0.35rem !important;
      transition: all 0.2s ease !important;
    }
    .upload-btn:hover {
      background: #1D4ED8 !important;
      transform: translateY(-1px);
    }
    .image-preview-card {
      width: 100%;
      border-radius: 14px;
      overflow: hidden;
      background: var(--bg-surface, #1A1D24);
      border: 1px solid var(--border-light, rgba(255, 255, 255, 0.12));
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }
    .image-preview-media {
      position: relative;
      width: 100%;
      height: 240px;
      background: #0D1117;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .preview-badge {
      position: absolute;
      top: 12px;
      left: 12px;
      z-index: 2;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(8px);
      color: #FFFFFF;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      padding: 4px 10px;
      border-radius: 6px;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }
    .image-preview-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .image-preview-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.85rem 1.15rem;
      background: var(--bg-surface-elevated, #16181D);
      border-top: 1px solid var(--border-light, rgba(255, 255, 255, 0.08));
    }
    .image-meta {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      color: var(--text-secondary, #9CA3AF);
      font-size: 0.85rem;
      overflow: hidden;
      max-width: 60%;
    }
    .image-preview-name {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      font-weight: 500;
      color: var(--text-primary, #FFFFFF);
    }
    .image-preview-actions {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }
    .image-action-btn {
      display: inline-flex !important;
      align-items: center !important;
      gap: 0.4rem !important;
      padding: 0.45rem 0.9rem !important;
      font-size: 0.8rem !important;
      font-weight: 600 !important;
      border-radius: 8px !important;
      cursor: pointer !important;
      transition: all 0.15s ease !important;
    }
    .image-action-btn.change {
      background: var(--bg-surface, #21262D) !important;
      color: var(--text-primary, #F0F6FC) !important;
      border: 1px solid var(--border-light, rgba(255, 255, 255, 0.15)) !important;
    }
    .image-action-btn.change:hover {
      background: var(--bg-hover, #30363D) !important;
      border-color: #3B82F6 !important;
    }
    .image-action-btn.remove {
      background: rgba(220, 38, 38, 0.12) !important;
      color: #F87171 !important;
      border: 1px solid rgba(220, 38, 38, 0.3) !important;
    }
    .image-action-btn.remove:hover {
      background: #DC2626 !important;
      color: #FFFFFF !important;
      border-color: #DC2626 !important;
    }
    .upload-error-box {
      margin-top: 0.6rem;
      padding: 0.65rem 0.9rem;
      background: rgba(220, 38, 38, 0.1);
      border: 1px solid rgba(220, 38, 38, 0.3);
      border-radius: 8px;
      color: #F87171;
      font-size: 0.85rem;
      font-weight: 500;
    }
  </style>

  <!-- Marked library for live client-side preview in admin editor -->
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
</head>
<body class="admin-layout">
  <%- include('sidebar') %>

  <div class="admin-main">
    <header class="admin-topbar">
      <div class="admin-topbar-left">
        <button type="button" class="admin-menu-btn" aria-label="Open navigation menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
        <h1 style="font-size: 1.25rem; font-weight: 700; margin: 0;">
          <%= isEdit ? 'Edit Article' : 'Create New Article' %>
        </h1>
      </div>
      <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
        <a href="/admin/articles" class="btn-pill-outline">Cancel</a>
        <button type="submit" form="article-form" class="btn-pill-primary">
          <%= isEdit ? 'Save Changes' : 'Create Article' %>
        </button>
      </div>
    </header>

    <main class="admin-content">
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error" role="alert"><%= error %></div>
      <% } %>

      <form 
        id="article-form" 
        action="<%= isEdit ? '/admin/articles/edit/' + article._id : '/admin/articles/new' %>" 
        method="POST"
        enctype="multipart/form-data"
      >
        <div class="data-card" style="padding: 2rem;">
          <div class="form-grid-2">
            <!-- Title -->
            <div class="form-group form-full">
              <label for="title" class="form-label">Article Title *</label>
              <input 
                type="text" 
                id="title" 
                name="title" 
                class="form-input" 
                required 
                maxlength="200"
                placeholder="e.g. How I Set Up My Developer Environment"
                value="<%= article.title || '' %>"
              >
            </div>

            <!-- Slug -->
            <div class="form-group">
              <label for="slug" class="form-label">Slug (URL identifier) *</label>
              <input 
                type="text" 
                id="slug" 
                name="slug" 
                class="form-input" 
                required 
                placeholder="e.g. how-i-set-up-my-developer-environment"
                value="<%= article.slug || '' %>"
              >
            </div>

            <!-- Subtitle -->
            <div class="form-group">
              <label for="subtitle" class="form-label">Subtitle</label>
              <input 
                type="text" 
                id="subtitle" 
                name="subtitle" 
                class="form-input" 
                placeholder="A short subtitle under the title"
                value="<%= article.subtitle || '' %>"
              >
            </div>

            <!-- Category -->
            <div class="form-group">
              <label for="category" class="form-label">Category *</label>
              <select id="category" name="category" class="category-dropdown-select" style="width: 100%;" required>
                <% categories.forEach(function(cat) { %>
                  <option 
                    value="<%= cat.name %>" 
                    <%= (article.category && article.category === cat.name) ? 'selected' : '' %>
                  >
                    <%= cat.name %>
                  </option>
                <% }); %>
              </select>
            </div>

            <!-- Status -->
            <div class="form-group">
              <label for="status" class="form-label">Publication Status *</label>
              <select id="status" name="status" class="category-dropdown-select" style="width: 100%;" required>
                <option value="draft" <%= article.status === 'draft' ? 'selected' : '' %>>Draft (Private)</option>
                <option value="published" <%= article.status === 'published' ? 'selected' : '' %>>Published (Public)</option>
              </select>
            </div>

            <!-- Cover Image Upload -->
            <div class="form-group form-full">
              <label class="form-label" style="font-weight: 600; margin-bottom: 0.6rem; display: block;">Cover Image</label>
              <% const currentCover = article.coverImage || ''; %>
              <input type="hidden" name="existingCoverImage" value="<%= currentCover %>">

              <div class="image-upload-wrapper" id="coverUploadWrapper">
                <!-- Dropzone Area (active when no image chosen or removed) -->
                <div class="image-upload-area <%= currentCover ? 'has-image' : '' %>" id="coverDropZone" style="<%= currentCover ? 'display: none;' : 'display: block;' %>">
                  <div class="upload-placeholder" id="coverPlaceholder">
                    <div class="upload-icon-circle">
                      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                        <polyline points="21 15 16 10 5 21"></polyline>
                      </svg>
                    </div>
                    <div class="upload-text-block">
                      <span class="upload-placeholder-title">Drop your cover image here, or <span class="upload-browse-link">browse</span></span>
                      <span class="upload-placeholder-hint">Supports JPEG, PNG, or WebP &bull; Maximum file size: 5 MB</span>
                    </div>
                    <button type="button" class="upload-btn" id="coverBrowseBtn">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="17 8 12 3 7 8"></polyline>
                        <line x1="12" y1="3" x2="12" y2="15"></line>
                      </svg>
                      Choose Image
                    </button>
                  </div>
                </div>

                <!-- Preview Card (active when cover exists or file selected) -->
                <div class="image-preview-card" id="coverPreview" style="<%= currentCover ? 'display: block;' : 'display: none;' %>">
                  <div class="image-preview-media">
                    <div class="preview-badge" id="coverBadge"><%= (isEdit && currentCover) ? 'Current Cover' : 'Selected Cover' %></div>
                    <img 
                      class="image-preview-img" 
                      id="coverPreviewImg" 
                      <% if (currentCover) { %>src="<%= currentCover %>"<% } %>
                      alt="Cover image preview"
                      style="<%= currentCover ? 'display: block;' : 'display: none;' %>"
                    >
                  </div>
                  <div class="image-preview-footer">
                    <div class="image-meta">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                        <polyline points="21 15 16 10 5 21"></polyline>
                      </svg>
                      <span class="image-preview-name" id="coverFileName"><%= currentCover ? currentCover.split('/').pop() : '' %></span>
                    </div>
                    <div class="image-preview-actions">
                      <button type="button" class="image-action-btn change" id="coverChangeBtn">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                          <polyline points="17 8 12 3 7 8"></polyline>
                          <line x1="12" y1="3" x2="12" y2="15"></line>
                        </svg>
                        Change
                      </button>
                      <button type="button" class="image-action-btn remove" id="coverRemoveBtn">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <polyline points="3 6 5 6 21 6"></polyline>
                          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        </svg>
                        Remove
                      </button>
                    </div>
                  </div>
                </div>

                <div class="upload-error-box" id="coverUploadError" style="display: none;"></div>
                <input 
                  type="file" 
                  id="coverImageInput" 
                  name="coverImage" 
                  accept="image/jpeg, image/png, image/webp" 
                  style="display: none;"
                >
              </div>
            </div>

            <!-- Tags -->
            <div class="form-group">
              <label for="tags" class="form-label">Tags (comma-separated)</label>
              <input 
                type="text" 
                id="tags" 
                name="tags" 
                class="form-input" 
                placeholder="Development, Linux, Productivity"
                value="<%= article.tags ? (Array.isArray(article.tags) ? article.tags.join(', ') : article.tags) : '' %>"
              >
            </div>

            <!-- Featured Checkbox -->
            <div class="form-group form-full" style="display: flex; align-items: center; gap: 0.5rem;">
              <input 
                type="checkbox" 
                id="isFeatured" 
                name="isFeatured" 
                <%= article.isFeatured ? 'checked' : '' %>
                style="width: 18px; height: 18px; cursor: pointer;"
              >
              <label for="isFeatured" style="font-size: 0.95rem; font-weight: 600; cursor: pointer;">
                Mark as Featured Article (shown prominently on Home page)
              </label>
            </div>

            <!-- Excerpt -->
            <div class="form-group form-full">
              <label for="excerpt" class="form-label">Excerpt / Summary *</label>
              <textarea 
                id="excerpt" 
                name="excerpt" 
                class="form-textarea" 
                style="min-height: 80px;" 
                required 
                maxlength="500"
                placeholder="Short summary for card previews..."
              ><%= article.excerpt || '' %></textarea>
            </div>

            <!-- Markdown Content Editor with Live Preview -->
            <div class="form-group form-full">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                <label for="content" class="form-label" style="margin-bottom: 0;">Article Content (Markdown supported) *</label>
                <span style="font-size: 0.75rem; color: var(--text-muted);">Live Preview on the Right &rarr;</span>
              </div>

              <div class="markdown-editor-split">
                <textarea 
                  id="content" 
                  name="content" 
                  class="markdown-textarea" 
                  required
                  placeholder="Write your article in Markdown..."
                ><%= article.content || '' %></textarea>

                <div id="markdown-preview" class="markdown-preview-pane prose">
                  <!-- Live markdown rendered here -->
                </div>
              </div>
            </div>
          </div>
        </div>
      </form>
    </main>
  </div>

  <script src="/js/theme.js"></script>
  <script>
    // Live Markdown Preview, Slug auto-generation, and Cover Image Upload
    document.addEventListener('DOMContentLoaded', () => {
      const titleInput = document.getElementById('title');
      const slugInput = document.getElementById('slug');
      const contentTextarea = document.getElementById('content');
      const previewPane = document.getElementById('markdown-preview');

      // Auto-generate slug from title if slug not customized
      <% if (!isEdit) { %>
        titleInput.addEventListener('input', () => {
          slugInput.value = titleInput.value
            .toLowerCase()
            .trim()
            .replace(/[^\w\s-]/g, '')
            .replace(/[\s_-]+/g, '-')
            .replace(/^-+|-+$/g, '');
        });
      <% } %>

      // Live markdown rendering
      function updatePreview() {
        if (typeof marked !== 'undefined') {
          previewPane.innerHTML = marked.parse(contentTextarea.value || '*Live preview will appear here as you type...*');
        }
      }

      contentTextarea.addEventListener('input', updatePreview);
      updatePreview();

      // ── Cover Image Upload UI ──
      const coverInput = document.getElementById('coverImageInput');
      const dropZone = document.getElementById('coverDropZone');
      const placeholder = document.getElementById('coverPlaceholder');
      const preview = document.getElementById('coverPreview');
      const previewImg = document.getElementById('coverPreviewImg');
      const fileName = document.getElementById('coverFileName');
      const browseBtn = document.getElementById('coverBrowseBtn');
      const changeBtn = document.getElementById('coverChangeBtn');
      const removeBtn = document.getElementById('coverRemoveBtn');
      const errorEl = document.getElementById('coverUploadError');
      const existingInput = document.querySelector('input[name="existingCoverImage"]');

      const MAX_SIZE = 5 * 1024 * 1024;
      const ALLOWED = ['image/jpeg', 'image/png', 'image/webp'];

      function formatSize(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / 1048576).toFixed(1) + ' MB';
      }

      function showError(msg) {
        errorEl.textContent = msg;
        errorEl.style.display = 'block';
      }

      function clearError() {
        errorEl.textContent = '';
        errorEl.style.display = 'none';
      }

      function handleFile(file) {
        clearError();

        if (!ALLOWED.includes(file.type)) {
          showError('Unsupported file type. Please use JPEG, PNG, or WebP.');
          return;
        }

        if (file.size > MAX_SIZE) {
          showError(`File is too large (${formatSize(file.size)}). Maximum size is 5 MB.`);
          return;
        }

        // Show preview
        const url = URL.createObjectURL(file);
        previewImg.src = url;
        previewImg.style.display = 'block';
        fileName.textContent = `${file.name} (${formatSize(file.size)})`;
        dropZone.style.display = 'none';
        preview.style.display = 'block';
        const badge = document.getElementById('coverBadge');
        if (badge) badge.textContent = 'Selected Cover';
      }

      function openFilePicker() {
        coverInput.click();
      }

      coverInput.addEventListener('change', () => {
        if (coverInput.files && coverInput.files[0]) {
          handleFile(coverInput.files[0]);
        }
      });

      browseBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        openFilePicker();
      });

      dropZone.addEventListener('click', (e) => {
        openFilePicker();
      });

      changeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        openFilePicker();
      });

      removeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        coverInput.value = '';
        previewImg.removeAttribute('src');
        previewImg.style.display = 'none';
        fileName.textContent = '';
        preview.style.display = 'none';
        dropZone.style.display = 'block';
        dropZone.classList.remove('has-image');
        existingInput.value = '';
        clearError();
      });

      // Drag and drop
      dropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.classList.add('dragover');
      });

      dropZone.addEventListener('dragleave', () => {
        dropZone.classList.remove('dragover');
      });

      dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('dragover');
        if (e.dataTransfer.files && e.dataTransfer.files[0]) {
          const dt = new DataTransfer();
          dt.items.add(e.dataTransfer.files[0]);
          coverInput.files = dt.files;
          handleFile(e.dataTransfer.files[0]);
        }
      });
    });
  </script>
</body>
</html>

