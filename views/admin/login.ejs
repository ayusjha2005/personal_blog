<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <script>
    (function() {
      try {
        var saved = localStorage.getItem('theme');
        var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}
    })();
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/css/themes.css">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="login-body">
  <div class="login-card">
    <div class="login-brand">
      <a href="/" style="font-size: 1.5rem; font-weight: 800; color: var(--text-primary); text-decoration: none;">
        Ayush Jha
      </a>
      <h1 class="login-title" style="margin-top: 1rem;">Admin Portal</h1>
      <p class="login-subtitle">Sign in to manage your blog articles and settings</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error" role="alert"><%= error %></div>
    <% } %>

    <form action="/admin/login" method="POST">
      <div class="form-group">
        <label for="email" class="form-label">Email Address</label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          class="form-input" 
          placeholder="admin@example.com" 
          required 
          value="<%= typeof email !== 'undefined' ? email : '' %>"
          autocomplete="email"
        >
      </div>

      <div class="form-group">
        <label for="password" class="form-label">Password</label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          class="form-input" 
          placeholder="••••••••••••" 
          required 
          autocomplete="current-password"
        >
      </div>

      <button type="submit" class="btn-pill-primary" style="width: 100%; justify-content: center; padding: 0.85rem; margin-top: 0.5rem;">
        Sign In to Dashboard
      </button>

      <div style="text-align: center; margin-top: 1.5rem;">
        <a href="/" style="font-size: 0.85rem; color: var(--text-secondary); text-decoration: underline;">
          &larr; Return to public blog
        </a>
      </div>
    </form>
  </div>

  <script src="/js/theme.js"></script>
</body>
</html>
