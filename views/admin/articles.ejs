<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <script>
    (function() {
      try {
        var saved = localStorage.getItem('theme');
        var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}
    })();
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/css/themes.css">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/admin.css?v=2">
</head>
<body class="admin-layout">
  <%- include('sidebar') %>

  <div class="admin-main">
    <header class="admin-topbar">
      <h1 style="font-size: 1.25rem; font-weight: 700;">Manage Articles</h1>
      <a href="/admin/articles/new" class="btn-pill-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        <span>New Article</span>
      </a>
    </header>

    <main class="admin-content">
      <!-- Search & Filters -->
      <div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap;">
        <div style="display: flex; gap: 0.5rem;">
          <a href="/admin/articles" class="filter-chip <%= !currentStatus ? 'active' : '' %>">All (<%= totalArticles %>)</a>
          <a href="/admin/articles?status=published" class="filter-chip <%= currentStatus === 'published' ? 'active' : '' %>">Published</a>
          <a href="/admin/articles?status=draft" class="filter-chip <%= currentStatus === 'draft' ? 'active' : '' %>">Drafts</a>
        </div>

        <form action="/admin/articles" method="GET" style="display: flex; gap: 0.5rem; max-width: 320px; width: 100%;">
          <input 
            type="text" 
            name="q" 
            class="form-input" 
            placeholder="Search articles..." 
            value="<%= searchQuery || '' %>"
            style="padding: 0.5rem 0.85rem; font-size: 0.875rem;"
          >
          <% if (currentStatus) { %>
            <input type="hidden" name="status" value="<%= currentStatus %>">
          <% } %>
          <button type="submit" class="btn-pill-primary" style="padding: 0.5rem 1rem; font-size: 0.875rem;">Search</button>
        </form>
      </div>

      <!-- Articles Data Table -->
      <div class="data-card">
        <div style="overflow-x: auto;">
          <table class="data-table">
            <thead>
              <tr>
                <th>Article</th>
                <th>Category</th>
                <th>Status</th>
                <th>Views</th>
                <th>Date</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (articles && articles.length > 0) { %>
                <% articles.forEach(function(article) { %>
                  <tr>
                    <td style="max-width: 320px;">
                      <div style="font-weight: 700; color: var(--text-primary);"><%= article.title %></div>
                      <div style="font-size: 0.75rem; color: var(--text-muted); font-family: monospace;">/<%= article.slug %></div>
                      <% if (article.isFeatured) { %>
                        <span style="font-size: 0.7rem; background: #EFF6FF; color: #2563EB; padding: 0.1rem 0.4rem; border-radius: 4px; font-weight: 600;">Featured</span>
                      <% } %>
                    </td>
                    <td><%= article.category ? article.category.name : 'Uncategorized' %></td>
                    <td>
                      <span class="table-status-pill <%= article.status === 'published' ? 'status-published' : 'status-draft' %>">
                        <%= article.status %>
                      </span>
                    </td>
                    <td><%= article.views || 0 %></td>
                    <td><%= formatDate(article.publishedAt || article.createdAt) %></td>
                    <td>
                      <div class="table-actions">
                        <form action="/admin/articles/<%= article._id %>/toggle" method="POST" style="display: inline;">
                          <button type="submit" class="icon-btn" title="<%= article.status === 'published' ? 'Unpublish (set to Draft)' : 'Publish Article' %>">
                            <% if (article.status === 'published') { %>
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2" title="Unpublish">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                              </svg>
                            <% } else { %>
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2" title="Publish">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                <polyline points="22 4 12 14.01 9 11.01"></polyline>
                              </svg>
                            <% } %>
                          </button>
                        </form>
                        <a href="/admin/articles/edit/<%= article._id %>" class="icon-btn" title="Edit Article">
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                          </svg>
                        </a>
                        <a href="/blog/<%= article.slug %>" target="_blank" class="icon-btn" title="View Public Page">
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                          </svg>
                        </a>
                        <form action="/admin/articles/delete/<%= article._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this article? This action cannot be undone.');" style="display: inline;">
                          <button type="submit" class="icon-btn" title="Delete Article" style="color: var(--accent-highlight);">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <polyline points="3 6 5 6 21 6"></polyline>
                              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                            </svg>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="6" style="text-align: center; padding: 3rem; color: var(--text-muted);">
                    No articles match your query.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Pagination -->
      <% if (totalPages > 1) { %>
        <div style="display: flex; justify-content: center; gap: 0.5rem; margin-top: 1.5rem;">
          <% for (let i = 1; i <= totalPages; i++) { %>
            <a href="/admin/articles?page=<%= i %><%= currentStatus ? '&status=' + currentStatus : '' %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" class="page-btn <%= i === currentPage ? 'active' : '' %>">
              <%= i %>
            </a>
          <% } %>
        </div>
      <% } %>
    </main>
  </div>

  <script src="/js/theme.js"></script>
</body>
</html>
