<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <script>
    (function() {
      try {
        var saved = localStorage.getItem('theme');
        var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}
    })();
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/css/themes.css">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/admin.css?v=2">
</head>
<body class="admin-layout">
  <%- include('sidebar') %>

  <div class="admin-main">
    <header class="admin-topbar">
      <h1 style="font-size: 1.25rem; font-weight: 700;">Website Settings</h1>
      <button type="submit" form="settings-form" class="btn-pill-primary">
        Save Settings
      </button>
    </header>

    <main class="admin-content">
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success" role="alert"><%= success %></div>
      <% } %>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error" role="alert"><%= error %></div>
      <% } %>

      <form id="settings-form" action="/admin/settings" method="POST">
        <!-- General Website Settings -->
        <div class="data-card" style="padding: 2rem;">
          <h2 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 1.5rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-light);">
            General Site Preferences
          </h2>

          <div class="form-grid-2">
            <div class="form-group">
              <label for="websiteTitle" class="form-label">Website Title</label>
              <input type="text" id="websiteTitle" name="websiteTitle" class="form-input" value="<%= settings.websiteTitle || 'Ayush Jha | Ideas. Code. Progress.' %>" required>
            </div>

            <div class="form-group">
              <label for="contactEmail" class="form-label">Contact Notification Email</label>
              <input type="email" id="contactEmail" name="contactEmail" class="form-input" value="<%= settings.contactEmail || 'ayushjha@gmail.com' %>" required>
            </div>

            <div class="form-group">
              <label for="postsPerPage" class="form-label">Articles Per Page (Pagination)</label>
              <input type="number" id="postsPerPage" name="postsPerPage" class="form-input" min="1" max="50" value="<%= settings.postsPerPage || 6 %>" required>
            </div>

            <div class="form-group">
              <label for="footerContent" class="form-label">Footer Copyright Notice</label>
              <input type="text" id="footerContent" name="footerContent" class="form-input" value="<%= settings.footerContent || '© 2026 Ayush Jha. All rights reserved.' %>" required>
            </div>

            <div class="form-group form-full">
              <label for="websiteDescription" class="form-label">Default SEO Description</label>
              <textarea id="websiteDescription" name="websiteDescription" class="form-textarea" style="min-height: 80px;"><%= settings.websiteDescription || '' %></textarea>
            </div>
          </div>
        </div>

        <!-- Social Media Profiles -->
        <div class="data-card" style="padding: 2rem;">
          <h2 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 1.5rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-light);">
            Social Channels &amp; Links
          </h2>

          <div class="form-grid-2">
            <div class="form-group">
              <label for="github" class="form-label">GitHub Profile URL</label>
              <input type="url" id="github" name="github" class="form-input" value="<%= (settings.socialLinks && settings.socialLinks.github) || 'https://github.com/ayushjha' %>">
            </div>

            <div class="form-group">
              <label for="linkedin" class="form-label">LinkedIn Profile URL</label>
              <input type="url" id="linkedin" name="linkedin" class="form-input" value="<%= (settings.socialLinks && settings.socialLinks.linkedin) || 'https://linkedin.com/in/ayushjha' %>">
            </div>

            <div class="form-group">
              <label for="twitter" class="form-label">X / Twitter URL</label>
              <input type="url" id="twitter" name="twitter" class="form-input" value="<%= (settings.socialLinks && settings.socialLinks.twitter) || 'https://x.com/ayushjha' %>">
            </div>

            <div class="form-group">
              <label for="instagram" class="form-label">Instagram URL</label>
              <input type="url" id="instagram" name="instagram" class="form-input" value="<%= (settings.socialLinks && settings.socialLinks.instagram) || 'https://instagram.com/ayushjha' %>">
            </div>

            <div class="form-group">
              <label for="youtube" class="form-label">YouTube URL</label>
              <input type="url" id="youtube" name="youtube" class="form-input" value="<%= (settings.socialLinks && settings.socialLinks.youtube) || '' %>">
            </div>

            <div class="form-group">
              <label for="email" class="form-label">Public Email Address</label>
              <input type="text" id="email" name="email" class="form-input" value="<%= (settings.socialLinks && settings.socialLinks.email) || 'ayushjha@gmail.com' %>">
            </div>
          </div>
        </div>
      </form>
    </main>
  </div>

  <script src="/js/theme.js"></script>
</body>
</html>
