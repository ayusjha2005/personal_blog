<%- include('../partials/head') %>
<body>
  <%- include('../partials/navbar') %>

  <main class="site-main about-section" id="main-content">
    <div class="container">
      <div class="about-card-wrapper">
        <!-- Left: Portrait Photo Card with Cursive Script Quote -->
        <div class="about-photo-card">
          <div class="about-photo-img-wrap">
            <img src="<%= profile.profileImage || '/images/profile.jpg' %>" alt="<%= profile.name || 'Ayush Jha' %>" class="about-photo-img">
          </div>
          <div class="photo-dots" aria-hidden="true">
            <span class="photo-dot active"></span>
            <span class="photo-dot"></span>
            <span class="photo-dot"></span>
          </div>
          <p class="about-script-phrase script-font">
            <%= profile.aboutScriptQuote || 'Just a guy who loves building things.' %>
          </p>
        </div>

        <!-- Center: Main Bio & Details -->
        <div class="about-main-info">
          <h1 class="about-heading">
            Hey, I'm <span class="name-highlight"><%= profile.name || 'Ayush Jha' %></span>
          </h1>

          <p class="about-bio-text">
            <%= profile.bio || "A Computer Science student who loves building things, learning new technologies, and exploring how software can solve real-world problems." %>
          </p>

          <p class="about-bio-text">
            <%= profile.extendedBio || "This blog is my digital journal where I share my learnings, projects, thoughts, and experiences in tech and life." %>
          </p>

          <div class="about-badges-list">
            <div class="badge-item">
              <div class="badge-icon-box" style="color: #7C3AED;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                  <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                </svg>
              </div>
              <span><%= profile.degree || 'B.Tech CSE (CSBS) @ VIT-AP' %></span>
            </div>

            <div class="badge-item">
              <div class="badge-icon-box" style="color: #059669;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <span><%= profile.location || 'Based in India' %></span>
            </div>

            <div class="badge-item">
              <div class="badge-icon-box" style="color: #D97706;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
                </svg>
              </div>
              <span><%= profile.statusText || 'Always learning' %></span>
            </div>
          </div>

          <div class="about-social-row">
            <div class="social-icons-group">
              <% if (profile.socialLinks && profile.socialLinks.github) { %>
                <a href="<%= profile.socialLinks.github %>" target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="GitHub">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                  </svg>
                </a>
              <% } %>

              <% if (profile.socialLinks && profile.socialLinks.linkedin) { %>
                <a href="<%= profile.socialLinks.linkedin %>" target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="LinkedIn">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                    <rect x="2" y="9" width="4" height="12"></rect>
                    <circle cx="4" cy="4" r="2"></circle>
                  </svg>
                </a>
              <% } %>

              <% if (profile.socialLinks && profile.socialLinks.twitter) { %>
                <a href="<%= profile.socialLinks.twitter %>" target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="Twitter">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path>
                  </svg>
                </a>
              <% } %>

              <% if (profile.socialLinks && profile.socialLinks.instagram) { %>
                <a href="<%= profile.socialLinks.instagram %>" target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="Instagram">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                  </svg>
                </a>
              <% } %>
            </div>

            <a href="/blog?category=projects" class="btn-pill-primary">
              <span>View My Projects</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>

        <!-- Right: What I Write About Cards -->
        <div class="about-topics-column">
          <h2 class="about-topics-heading">What I Write About</h2>

          <div class="topic-box-card">
            <div class="topic-box-icon" style="background-color: #EFF6FF; color: #2563EB;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
              </svg>
            </div>
            <div>
              <div class="topic-box-title">Web Development</div>
              <div class="topic-box-desc">Full-stack projects, tools and tutorials.</div>
            </div>
          </div>

          <div class="topic-box-card">
            <div class="topic-box-icon" style="background-color: #FEF3C7; color: #D97706;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                <polyline points="2 17 12 22 22 17"></polyline>
                <polyline points="2 12 12 17 22 12"></polyline>
              </svg>
            </div>
            <div>
              <div class="topic-box-title">DSA &amp; Algorithms</div>
              <div class="topic-box-desc">Problem solving and preparation.</div>
            </div>
          </div>

          <div class="topic-box-card">
            <div class="topic-box-icon" style="background-color: #ECFDF5; color: #059669;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="4 17 10 11 4 5"></polyline>
                <line x1="12" y1="19" x2="20" y2="19"></line>
              </svg>
            </div>
            <div>
              <div class="topic-box-title">Linux &amp; Tools</div>
              <div class="topic-box-desc">Productivity, terminal and setups.</div>
            </div>
          </div>

          <div class="topic-box-card">
            <div class="topic-box-icon" style="background-color: #F5F3FF; color: #7C3AED;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
              </svg>
            </div>
            <div>
              <div class="topic-box-title">Projects &amp; Hackathons</div>
              <div class="topic-box-desc">Builds, ideas and open source.</div>
            </div>
          </div>

          <div class="topic-box-card">
            <div class="topic-box-icon" style="background-color: #FEF2F2; color: #DC2626;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
              </svg>
            </div>
            <div>
              <div class="topic-box-title">Career &amp; Internships</div>
              <div class="topic-box-desc">Roadmaps, interviews and experiences.</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>

  <script src="/js/theme.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
