<%- include('../partials/head') %>
<body>
  <%- include('../partials/navbar') %>

  <main class="site-main contact-section" id="main-content">
    <div class="container">
      <div class="contact-grid">
        <!-- Left Side: Mountain Card with Info & Handwritten Script -->
        <div class="contact-left-card">
          <div class="contact-bg-wrap">
            <img src="/images/contact-mountain.jpg" alt="Majestic mountains through clouds" class="contact-bg-img">
            <div class="contact-overlay"></div>
          </div>

          <div class="contact-left-content">
            <h1 class="contact-heading">Let's Connect</h1>
            <p class="contact-subtext">Have a question, suggestion, or just want to say hi? I'd love to hear from you.</p>

            <div class="contact-details-list">
              <div class="contact-info-item">
                <div class="contact-info-icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                    <polyline points="22,6 12,13 2,6"></polyline>
                  </svg>
                </div>
                <div>
                  <div class="contact-info-label">Email</div>
                  <a href="mailto:<%= profile.contactEmail || 'ayushjha@gmail.com' %>" class="contact-info-val">
                    <%= profile.contactEmail || 'ayushjha@gmail.com' %>
                  </a>
                </div>
              </div>

              <div class="contact-info-item">
                <div class="contact-info-icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                </div>
                <div>
                  <div class="contact-info-label">Location</div>
                  <div class="contact-info-val"><%= profile.location || 'India' %></div>
                </div>
              </div>

              <% if (profile.socialLinks && profile.socialLinks.linkedin) { %>
                <div class="contact-info-item">
                  <div class="contact-info-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                      <rect x="2" y="9" width="4" height="12"></rect>
                      <circle cx="4" cy="4" r="2"></circle>
                    </svg>
                  </div>
                  <div>
                    <div class="contact-info-label">LinkedIn</div>
                    <a href="<%= profile.socialLinks.linkedin %>" target="_blank" rel="noopener noreferrer" class="contact-info-val">
                      linkedin.com/in/ayushjha
                    </a>
                  </div>
                </div>
              <% } %>

              <% if (profile.socialLinks && profile.socialLinks.github) { %>
                <div class="contact-info-item">
                  <div class="contact-info-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                    </svg>
                  </div>
                  <div>
                    <div class="contact-info-label">GitHub</div>
                    <a href="<%= profile.socialLinks.github %>" target="_blank" rel="noopener noreferrer" class="contact-info-val">
                      github.com/ayushjha
                    </a>
                  </div>
                </div>
              <% } %>
            </div>
          </div>

          <div class="contact-script-overlay script-font">
            <%= profile.contactScriptQuote || "Let's Build Something Amazing." %>
          </div>
        </div>

        <!-- Right Side: Contact Form Card -->
        <div class="contact-form-side">
          <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success" role="alert"><%= success %></div>
          <% } %>

          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error" role="alert"><%= error %></div>
          <% } %>

          <form action="/contact" method="POST" id="contact-form" novalidate>
            <!-- Anti-Spam Honeypot field (hidden from humans) -->
            <div style="display: none;" aria-hidden="true">
              <label for="website-field">Leave this field blank</label>
              <input type="text" id="website-field" name="website" tabindex="-1" autocomplete="off">
            </div>

            <div class="form-group">
              <label for="name" class="form-label">Your Name</label>
              <input 
                type="text" 
                id="name" 
                name="name" 
                class="form-input" 
                placeholder="Enter your name" 
                required 
                maxlength="100"
                value="<%= typeof formData !== 'undefined' && formData.name ? formData.name : '' %>"
              >
            </div>

            <div class="form-group">
              <label for="email" class="form-label">Your Email</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                class="form-input" 
                placeholder="Enter your email" 
                required 
                maxlength="120"
                value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
              >
            </div>

            <div class="form-group">
              <label for="subject" class="form-label">Subject</label>
              <input 
                type="text" 
                id="subject" 
                name="subject" 
                class="form-input" 
                placeholder="What is this regarding?" 
                maxlength="200"
                value="<%= typeof formData !== 'undefined' && formData.subject ? formData.subject : '' %>"
              >
            </div>

            <div class="form-group">
              <label for="message" class="form-label">Message</label>
              <textarea 
                id="message" 
                name="message" 
                class="form-textarea" 
                placeholder="Write your message..." 
                required 
                maxlength="5000"
              ><%= typeof formData !== 'undefined' && formData.message ? formData.message : '' %></textarea>
            </div>

            <button type="submit" class="btn-pill-primary" style="width: 100%; justify-content: center; padding: 0.85rem;">
              <span>Send Message</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>
          </form>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>

  <script src="/js/theme.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
