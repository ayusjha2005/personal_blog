# ==============================================================================
# AyushJha.dev Environment Configuration Template (.env.example)
# Copy this file to .env and provide your actual credentials.
# NEVER commit .env to version control.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=production
SITE_URL=https://ayushjha.dev

# MongoDB Connection
# Atlas URI: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string

# Session Security (Generate a strong 64-character random string)
SESSION_SECRET=your_secure_random_session_secret

# Initial Admin User Credentials (used by npm run create-admin)
ADMIN_EMAIL=admin@ayushjha.dev
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_NAME="Ayush Jha"

# Cloudinary Storage Configuration (for persistent article and profile images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Optional alternative for Cloudinary:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
